# PostgreSQL connection string (used by Drizzle ORM)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# REQUIRED in production – long random string used to sign JWTs.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Clinic wall-clock timezone used for slot generation and "past time" checks
CLINIC_TIMEZONE=Europe/London

# Set to "true" when serving over HTTPS so the auth cookie is marked Secure
COOKIE_SECURE=false
